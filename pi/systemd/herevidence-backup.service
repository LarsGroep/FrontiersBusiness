[Unit]
# App, database and backups live on the data disk (a no-op on servers without one).
RequiresMountsFor=/mnt/evidence
Description=Nightly backup of the evidence database
After=postgresql.service

[Service]
Type=oneshot
User=herevidence
EnvironmentFile=/etc/herevidence.env
ExecStart=/bin/bash /opt/herevidence/pi/backup.sh
Nice=10
IOSchedulingClass=idle
